        <activity android:name=".RelevanceEvaluationActivity" android:exported="false" />
        <activity android:name=".AttentionEvaluationActivity" android:exported="false" />
        <activity android:name=".CognitiveShadowActivity" android:exported="false" />
        <activity android:name=".CorrectionLearningActivity" android:exported="false" />
        <activity android:name=".FeatureHubActivity" android:exported="false" />
        <activity android:name=".PhoneContextAccessActivity" android:exported="false" />
        <activity android:name=".CapabilityMatrixActivity" android:exported="false" />
        <activity android:name=".EnvironmentActivity" android:exported="false" />
        <activity android:name=".CortexStatusActivity" android:exported="false" />
        <activity android:name=".CortexAuditActivity" android:exported="false" />
        <activity android:name=".ExternalModelCheckActivity" android:exported="false" />
        <activity android:name=".VisualIntelligenceActivity" android:exported="false" />
        <activity android:name=".OcrTestActivity" android:exported="false" />
        <activity android:name=".AsrSettingsActivity" android:exported="false" android:label="Cortex ASR Setup" />
